# Copy to .env.local if you need it. .env.local is git-ignored.

# Only needed when adding premium blocks with the shadcn CLI:
#   pnpm shadcn add @shadcnblocks/<block-name>
# Never commit the key, never prefix it with NEXT_PUBLIC_, never paste it into source files.
SHADCNBLOCKS_API_KEY=

# Keep the demo clock at Sunday 8 November 2026, 12:08 (used for the screenshots).
# KHMK_DEMO_CLOCK=frozen
